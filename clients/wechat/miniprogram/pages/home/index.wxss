.page{padding:36rpx;box-sizing:border-box}.header{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:56rpx}.brand{font-size:46rpx;font-weight:750;color:#267456}.language{min-height:88rpx;display:flex;align-items:center;border:1px solid #dce4da;border-radius:16rpx;padding:0 20rpx;font-size:28rpx}.eyebrow{font-size:22rpx;letter-spacing:4rpx;color:#687c72}.hero{font-size:76rpx;font-weight:750;line-height:1.15;margin:24rpx 0 32rpx;letter-spacing:-2rpx}.accent{color:#267456}textarea{box-sizing:border-box;width:100%;min-height:120rpx;border:1px solid #dce4da;border-radius:20rpx;padding:24rpx;margin:0 0 24rpx;font-size:30rpx;word-break:break-all}.error{color:#a03c29;font-size:26rpx;word-break:break-all}.quality{border:1px solid #84a46e;background:#edf4e7;border-radius:20rpx;padding:24rpx}.consent{display:flex;align-items:flex-start;font-size:26rpx;margin:30rpx 0;gap:12rpx}.job-title{font-weight:650;word-break:break-all;margin-bottom:12rpx}progress{margin:20rpx 0}.footer{padding:32rpx 0}.backdrop{position:fixed;inset:0;background:#183b3266;display:flex;align-items:center;justify-content:center;padding:24rpx;z-index:10}.modal{width:100%;max-height:85vh;overflow-y:auto;margin:0}.row{display:flex;justify-content:space-between;gap:30rpx;font-size:28rpx;margin:24rpx 0}.row text:last-child{text-align:right}.rtl{direction:rtl}
