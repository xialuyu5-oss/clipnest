page{background:#f7f8f3;color:#243d35;font-family:system-ui,-apple-system,sans-serif;font-size:32rpx;line-height:1.6}button{font-size:30rpx;min-height:96rpx;line-height:1.4;display:flex;align-items:center;justify-content:center;padding:22rpx 28rpx;border-radius:18rpx;background:#267456;color:#fff;white-space:normal;word-break:break-word}button::after{border:none}button[disabled]{opacity:.5}.quiet{background:#fff;color:#267456;border:1px solid #dce4da}.hint{font-size:26rpx;color:#687c72}.card{padding:36rpx;border:1px solid #dce4da;background:#fff;border-radius:32rpx;margin:32rpx 0}.title{font-size:38rpx;font-weight:650;margin-bottom:22rpx}.actions{display:flex;flex-wrap:wrap;gap:20rpx;margin-top:24rpx}.actions button{margin:0;flex:1 1 160rpx}
