# Copy to .env. Never put this file under web/, commit secrets, or send it to others.
# Personal local use: leave ACCESS_KEY and PUBLIC_ORIGIN empty.
# Public deployment: set a randomly generated access key of at least 16 printable ASCII
# characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
ACCESS_KEY=
# Exact external origin; no trailing path. Example: https://clips.example.com
PUBLIC_ORIGIN=
# Enable only when serving the website over HTTPS.
COOKIE_SECURE=false

# Optional server-side outbound proxy; not the visitor browser's proxy.
# For a local Windows install, set this to your actual proxy listening address.
# YTDLP_PROXY=http://127.0.0.1:7897
YTDLP_PROXY=

MAX_CONCURRENT_DOWNLOADS=2
MAX_QUEUE=20
# Downloads have no fixed file-size, duration or total-time limit. Users confirm each download.
# Stop only when actual free disk space drops below this reserve.
MIN_FREE_DISK_MB=512
ANALYZE_TIMEOUT_SECONDS=90
# Downloads and partial files remain until the user cancels or deletes the task.
ENABLE_DEMO=true
# Member login is local-only and stores Bilibili sessions only in memory.
# It requires the browser to connect from 127.0.0.1 itself. Set false for LAN, Docker
# (compose.yaml already forces false) or public deployments, otherwise every request
# is rejected with LOCAL_ONLY 403.
ENABLE_MEMBER_LOGIN=true

# Server logging. warning (default) records failed jobs/workers without URLs or titles.
# debug also records the worker's stderr tail. DEBUG_WORKER=true additionally forwards
# raw yt-dlp warnings/errors and tracebacks, which may contain source URLs; keep it off
# unless troubleshooting, and do not share such logs publicly.
LOG_LEVEL=warning
DEBUG_WORKER=false
# DATA_DIR=/absolute/path/to/clipnest-data
